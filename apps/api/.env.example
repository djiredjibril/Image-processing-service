# Copier vers .env (jamais commité) et adapter.
PORT=3001
DATABASE_URL=postgres://imageservice:imageservice@localhost:5433/imageservice_dev
TEST_DATABASE_URL=postgres://imageservice:imageservice@localhost:5433/imageservice_test
# Au moins 32 caractères ; générer par ex. avec : openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_EXPIRES_IN=1h
# Redis (cache et rate limiting). Port 6380 : voir docker-compose.yml. Base 0 = dev, base 1 = tests.
REDIS_URL=redis://localhost:6380/0
TEST_REDIS_URL=redis://localhost:6380/1
# Durée de vie, en secondes, d'une entrée du cache des transformations (86400 = 24 h).
CACHE_TTL_SECONDS=86400
# Rate limiting : requêtes max par fenêtre (RATE_LIMIT_WINDOW_SECONDS) et par palier.
# AUTH est compté par IP (/register, /login) ; les autres par utilisateur.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH=10
# Connexions par ADRESSE E-MAIL visée (fenêtre de 15 min), en plus de la limite par IP.
RATE_LIMIT_LOGIN_EMAIL=10
RATE_LIMIT_LOGIN_EMAIL_WINDOW_SECONDS=900
RATE_LIMIT_UPLOAD=20
RATE_LIMIT_TRANSFORM=10
RATE_LIMIT_READ=300
# File d'attente (BullMQ, phase 4) : tentatives max par job, délai avant la 1re nouvelle tentative (ms, doublé à chaque échec),
# jobs traités en parallèle par worker (chaque traitement sharp peut prendre ~1 Go de RAM : rester bas).
QUEUE_ATTEMPTS=3
QUEUE_BACKOFF_MS=1000
WORKER_CONCURRENCY=2
# Durcissement (phase 6) : nombre de reverse proxies de confiance devant l'API (0 = aucun ; à régler EXACTEMENT, sinon l'IP
# du client est fausse ou falsifiable) et transformations synchrones simultanées par process (chacune peut prendre ~1 Go de RAM).
TRUST_PROXY=0
MAX_CONCURRENT_TRANSFORMS=2
# Origine navigateur autorisée à appeler l'API (l'app Angular en dev). Une seule, exacte.
CORS_ORIGIN=http://localhost:4200
# Stockage des fichiers : `local` (disque) ou `s3` (SeaweedFS lancé par docker compose, ou tout stockage compatible S3).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage
# Obligatoires seulement avec STORAGE_DRIVER=s3 (valeurs ci-dessous = le SeaweedFS de docker-compose.yml, identifiants de dev).
# S3_ENDPOINT=http://localhost:8333
# S3_BUCKET=imageservice-dev
# S3_ACCESS_KEY_ID=imageservice
# S3_SECRET_ACCESS_KEY=imageservice-secret
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=true
# URLs présignées (GET /images/:id/url) : durée de validité en secondes (défaut 300, max 604800) et, si le navigateur doit joindre le
# stockage par une autre adresse que l'API (ex. API dans Docker), l'adresse publique à mettre dans les URLs.
# PRESIGNED_URL_TTL_SECONDS=300
# S3_PUBLIC_ENDPOINT=http://localhost:8333
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS_SIDE=8000
